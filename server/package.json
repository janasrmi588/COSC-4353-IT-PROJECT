{
  "name": "queuesmart-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "seed": "node --env-file-if-exists=.env src/seed/seed.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongoose": "^9.12.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "mongodb-memory-server": "^11.3.0",
    "vitest": "^5.0.5"
  }
}
